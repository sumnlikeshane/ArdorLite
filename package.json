{
  "name": "ardor-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.14.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "evidence:check": "python3.12 scripts/evidence_check.py",
    "content:check": "node --import tsx scripts/content_check.ts",
    "assets:prepare": "python3.12 scripts/assets_prepare.py",
    "check": "pnpm evidence:check && pnpm content:check && astro check",
    "build": "python3.12 -B scripts/build.py",
    "preview": "python3.12 -B scripts/serve_dist.py",
    "test:e2e": "playwright test",
    "prose:check": "node scripts/prose_check.mjs",
    "content:status": "python3.12 -B scripts/publication_policy.py",
    "entries:check": "node --import tsx scripts/entry_check.ts",
    "release:check": "python3.12 -B scripts/release_check.py",
    "release:package": "python3.12 -B scripts/release_package.py",
    "rollback:exercise": "python3.12 -B scripts/rollback_exercise.py"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@observablehq/plot": "0.6.17",
    "astro": "7.4.0",
    "lucide-static": "1.65.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "pagefind": "1.5.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
