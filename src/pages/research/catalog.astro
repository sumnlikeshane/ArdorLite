---
import SiteLayout from '../../layouts/SiteLayout.astro';
import OutcomeLabel from '../../components/OutcomeLabel.astro';
import {records,recordUrl} from '../../lib/evidence';
import { cases } from '../../lib/evidence';
import { evidenceCrosswalk as crosswalk } from '../../lib/evidence/crosswalk';
import taxonomy from '../../content/taxonomies.json';
const unique=(key:'original_verdict'|'instrument'|'reproduction_level')=>[...new Set(records.map(r=>r[key]).filter((s):s is string=>s!==null))].sort();
---
<SiteLayout title="Research catalog" description="All 114 reviewed Ardor research records, with original verdicts, controlling decisions, maturity and reproduction levels. Coverage, not independent strategy trials." type="catalog">
<header class="page-heading"><span class="eyebrow">The full research record</span><h1>A catalog of questions,<br />versions and decisions.</h1><p class="lede">114 scoped records: 49 archive-cohort records and 65 other designs, versions and paths. Mechanisms and stages overlap. This is a coverage inventory, not 114 independent strategy trials.</p><p class="small">These are reference records. Start with a text query, research family or explicit investigation context; use advanced controls for exact original metadata. Investigation context includes primary and explicitly related records, not inferred family membership.</p><p class="small">Source order is retained. Original-verdict filters use actual source wording; 52 original verdicts and 63 instrument fields are unavailable. No performance ranking is applied.</p></header>
<form data-pagefind-ignore id="catalog-filters" class="filter-form" hidden><label class="filter-query">Search within the catalog<input type="search" name="q" placeholder="Question, outcome, gate or record ID"/></label><label>Reading view<select name="view"><option value="list">Detailed list</option><option value="table">Compact table</option></select></label><label>Research family<select name="family"><option value="">All families</option>{Object.entries(taxonomy.family).map(([key,value])=><option value={key}>{value}</option>)}</select></label><label>Investigation context<select name="investigation"><option value="">All records</option>{cases.map(c=><option value={c.id}>{c.title}</option>)}</select></label><details class="catalog-advanced" id="catalog-advanced"><summary>Advanced reference filters: original verdict, instrument and reproduction</summary><div class="catalog-advanced-fields"><label>Original verdict<select name="original_status"><option value="">All original verdicts</option><option value="__unavailable">Unavailable</option>{unique('original_verdict').map(v=><option value={v}>{v}</option>)}</select></label><label>Instrument metadata<select name="instrument"><option value="">All instrument metadata</option><option value="__unavailable">Unavailable</option>{unique('instrument').map(v=><option value={v}>{v}</option>)}</select></label><label>Reproduction<select name="reproduction"><option value="">All reproduction levels</option>{unique('reproduction_level').map(v=><option value={v}>{v.replaceAll('_',' ')}</option>)}</select></label></div></details><div class="filter-actions"><span>Filters are stored in the URL.</span><div><button type="reset">Clear all</button> <button type="submit">Apply search</button></div></div></form>
<noscript><p class="evidence-note small">All 114 records are available below. URL filtering and compact view require JavaScript; use your browser's find command to search these entries.</p></noscript><p data-pagefind-ignore id="catalog-count" class="small" role="status" aria-live="polite">114 of 114 catalog records</p><p data-pagefind-ignore id="catalog-empty" class="evidence-note" hidden>No records match these filters. Clear all filters or try a broader phrase.</p>
<ul data-pagefind-ignore id="catalog-list" class="record-list">{records.map(r=><li class="record-item" data-catalog-record={r.id} data-family={r.family} data-investigation={[...new Set(crosswalk.recordCases(r.id).map(c=>c.case.id))].join(' ')} data-original_status={r.original_verdict??'__unavailable'} data-instrument={r.instrument??'__unavailable'} data-reproduction={r.reproduction_level} data-search={[r.id,r.title,r.hypothesis,r.original_verdict,r.status,r.final_outcome,r.controlling_gates].join(' ').toLocaleLowerCase()}><div><h2><a href={recordUrl(r.id)} data-catalog-link>{r.title}</a></h2><p>{r.final_outcome}</p><p><strong>Original verdict:</strong> {r.original_verdict??'Unavailable'}</p><p class="small"><strong>Controlling gate:</strong> {r.controlling_gates??'Unavailable'}</p></div><div class="record-meta"><OutcomeLabel status={r.status}/><span>{taxonomy.family[r.family as keyof typeof taxonomy.family]}</span><span>{r.reproduction_level}</span><span>Evidence maturity: {r.evidence.evidence_maturity}</span><span>Instrument: {r.instrument??'Unavailable'}</span></div></li>)}</ul>
<div data-pagefind-ignore id="catalog-table" class="table-scroll" role="region" tabindex="0" aria-label="Compact research catalog" hidden><table><caption>All matching catalog records, in source order</caption><thead><tr><th scope="col">Research record</th><th scope="col">Original verdict</th><th scope="col">Normalized status</th><th scope="col">Controlling decision</th><th scope="col">Reproduction</th></tr></thead><tbody>{records.map(r=><tr data-compact-record={r.id}><th scope="row"><a href={recordUrl(r.id)} data-catalog-link>{r.title}</a></th><td>{r.original_verdict??'Unavailable'}</td><td>{r.status}</td><td>{r.controlling_gates??r.final_outcome}</td><td>{r.reproduction_level}</td></tr>)}</tbody></table></div>
<p class="small" style="margin-block:35px">Instrument filtering retains exact supplied metadata, with an unavailable group. Method filtering is deferred because no reliable per-record method mapping is supplied.</p>
<script>import '../../scripts/catalog';</script>
</SiteLayout>
