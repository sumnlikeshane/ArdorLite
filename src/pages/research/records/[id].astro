---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import OutcomeLabel from '../../../components/OutcomeLabel.astro';
import ReproductionLabel from '../../../components/ReproductionLabel.astro';
import {records,recordUrl,recordById,caseById,claimUrl,formatValue,assetUrl,sourceById} from '../../../lib/evidence';
import { evidenceCrosswalk as crosswalk } from '../../../lib/evidence/crosswalk';
export function getStaticPaths(){return records.map(record=>({params:{id:record.id},props:{record}}));}
const {record:r}=Astro.props;
const relatedCases=crosswalk.recordCases(r.id);
const incomingRelations=crosswalk.incoming('record', r.id).filter(edge => ['record-parent','record-relation'].includes(edge.kind));
const titles: Record<string,string> = {observation_clock:'Observation clock',publication_clock:'Publication clock',decision_clock:'Decision clock',entry_convention:'Entry convention',horizon:'Horizon',research_dates:'Research dates'};
---
<SiteLayout title={r.title} description={r.final_outcome} type="record" status={r.status} reproduction={r.reproduction_level}>
<header class="page-heading"><p class="breadcrumb"><a href="/research/">Research</a> / <a href="/research/catalog/">Catalog</a> / Record</p><p><a href="/research/catalog/" data-return-catalog>Return to catalog results</a></p><p class="small">Reference record · For a guided argument, follow the related investigation links below. Original metadata and unknown fields are retained.</p><span class="eyebrow">{r.family.replaceAll('_',' ')} / {r.record_kind.replaceAll('_',' ')}</span><h1>{r.title}</h1><p class="lede">{r.hypothesis}</p><div class="outcomes"><OutcomeLabel status={r.status}/></div><p><strong>Original verdict:</strong> {r.original_verdict??'Unavailable'}</p><p><strong>Normalized status:</strong> <code>{r.status}</code></p><p style="max-width:75ch">{r.final_outcome}</p><p data-pagefind-weight="20" class="small">Stable record identity: <code>{r.id}</code></p></header>
<div class="prose"><h2>The controlling decision</h2><p>{r.controlling_gates??'Unavailable'}</p><p class="small">Original verdict basis: {r.original_verdict_basis}</p><dl class="record-facts"><dt>Unit metadata</dt><dd>{r.evidence.units===null?'Unavailable':r.evidence.units.join(' · ')}</dd><dt>Evidence maturity</dt><dd>{r.evidence.evidence_maturity}</dd><dt>Instrument</dt><dd>{r.instrument??'Unavailable'}</dd><dt>Record kind</dt><dd>{r.record_kind}</dd><dt>Catalog cohort</dt><dd>{r.catalog_cohort}</dd><dt>Original archive status</dt><dd>{r.archive_original_status??'Unavailable'}</dd><dt>Version</dt><dd>{r.version??'Unavailable'}</dd><dt>Parent</dt><dd>{r.parent_id?<a href={recordUrl(r.parent_id)}>{recordById.get(r.parent_id)!.title}</a>:'Unavailable'}</dd><dt>Source disposition</dt><dd>{r.source_disposition??'Unavailable'}</dd></dl>
<h2>Mechanism and information clocks</h2><p>{r.proposed_mechanism}</p><p><strong>Intended observable information:</strong> {r.intended_observable_information??'Unavailable'}</p><dl class="record-facts">{Object.entries(r.timing).map(([key,value])=><><dt>{titles[key]??key}</dt><dd>{formatValue(value)}</dd></>)}</dl>
<h2>Research design</h2><p>{r.design.summary}</p><dl class="record-facts">{Object.entries(r.design).filter(([key])=>key!=='summary').map(([key,value])=><><dt>{key.replaceAll('_',' ')}</dt><dd>{value??'Unavailable'}</dd></>)}</dl>
<h2>Reviewed values and limitations</h2>{r.evidence.canonical_metrics===null?<p>Canonical metrics are unavailable in this reviewed record. Values are not borrowed from a parent or adjacent version.</p>:<ul>{r.evidence.canonical_metrics.map(metric=><li>{metric.description}: <strong>{formatValue(metric.value)}</strong> {metric.unit} · <a href={claimUrl(metric.claim_id)}>Claim evidence</a></li>)}</ul>}<ul>{r.limitations.map(limit=><li>{limit}</li>)}</ul><p class="small">Metadata basis: {r.evidence.metadata_basis??'Unavailable'}</p>
<h2>Reproduction</h2><ReproductionLabel level={r.reproduction_level}/><dl class="record-facts">{Object.entries(r.reproduction).map(([key,value])=><><dt>{key.replaceAll('_',' ')}</dt><dd>{formatValue(value)}</dd></>)}</dl>
{r.relations.length>0 && <><h2>Related versions and paths</h2><ul data-pagefind-ignore>{r.relations.map(rel=><li>{rel.type.replaceAll('_',' ')}: <a href={recordUrl(rel.record_id)}>{recordById.get(rel.record_id)!.title}</a></li>)}</ul></>}
{incomingRelations.length>0 && <section data-pagefind-ignore aria-labelledby="incoming-relations"><h2 id="incoming-relations">Incoming record relations</h2><p class="small">The linked record declares this relation to the current record. Direction and original relation wording are retained; this does not merge versions or establish causal succession.</p><ul>{incomingRelations.map(edge => <li><a href={edge.from.href}>{edge.from.label}</a> → this record: {edge.basis.replaceAll('_',' ')}</li>)}</ul></section>}
{relatedCases.length>0 && <section data-pagefind-ignore aria-labelledby="case-context"><h2 id="case-context">Read in case context</h2><ul>{relatedCases.map(context => <li><a href={context.case.href}>{context.case.label}</a> — {context.role}{context.via ? <> through <a href={context.via.href}>{context.via.label}</a><br/><span class="small">Explicit relation: {context.basis}. This related record retains its own outcome and evidence scope.</span></> : <> — {caseById.get(context.case.id)!.summary}</>}</li>)}</ul></section>}
<div data-pagefind-ignore><h2>Source identities and publication</h2><p>Ardor source research. <a href="/publication/">Rights and attribution</a>.</p><p>Complete original reports and row-level data are excluded. Source references identify the material supporting this record; inclusion here does not grant redistribution rights.</p><p class="small">Omitted material: {r.publication.omitted}</p><ul data-pagefind-ignore>{r.sources.map(source=><li><a href={`/evidence/sources/#${source.source_id}`}>{source.source_id}</a> · {source.role}<br/><code>{source.source_relative_path}</code><br/><span class="small">SHA-256: <code>{source.sha256}</code>. Original unavailable; reviewed derivatives only.</span></li>)}</ul><p><a href={assetUrl(r.evidence.summary_path)}>Read the included reviewed summary</a></p>
</div><h3>Source index references</h3><ul data-pagefind-ignore>{r.source_index_references.map(source=><li><a href={`/evidence/sources/#${source.source_id}`}>{source.source_id}</a> · <code>{source.source_relative_path}</code><br/><span class="small">{!sourceById.has(source.source_id)&&'Directory provenance label; file hash unavailable.'}</span></li>)}</ul>
{r.evidence.claim_ids.length>0 && <><h2>All record claims</h2><ul data-pagefind-ignore>{r.evidence.claim_ids.map(id=><li><a href={claimUrl(id)}>{id}</a></li>)}</ul></>}
<p><a class="text-link" href="/research/catalog/">Back to the catalog</a></p></div>
<script>import '../../../scripts/catalog-return';</script>
</SiteLayout>
