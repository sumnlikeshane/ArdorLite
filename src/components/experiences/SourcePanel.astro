---
import { isPublicPublication, restrictedSourceNotice } from '../../lib/publication/scope';
import type { ReadingExcerpt } from '../../lib/experiences/captures';
import { evidenceCrosswalk } from '../../lib/evidence/crosswalk';
interface Props { excerpt: ReadingExcerpt; }
const { excerpt } = Astro.props;
const lines = 'text' in excerpt ? excerpt.text.slice(0, -1).split('\n') : [];
const frozenSource = evidenceCrosswalk.outgoing('excerpt', excerpt.id, 'excerpt-source')[0]?.to;
---
<details id={excerpt.id} class="exp-source" data-source-panel data-excerpt-id={excerpt.id}>
  <summary><span>Inspect original source</span><span class="exp-source-symbol">{excerpt.symbol}</span></summary>
  <div class="exp-source-body" id={`${excerpt.id}-capture`} tabindex="-1">
    <p class="exp-source-context"><strong>{excerpt.repositoryLabel}</strong> · <code>{excerpt.path}</code><br />{excerpt.versionContext}</p>
    <p class="exp-source-note">Exact captured Python · source lines {excerpt.lineStart}–{excerpt.lineEnd}. The browser explanation does not execute this Python.</p>
    {frozenSource && <p class="exp-source-note"><a href={frozenSource.href}>Reviewed source identity: {frozenSource.id}</a>. File path and hash match; capture and historical execution remain separate.</p>}
    {isPublicPublication ? <p data-public-source-omitted>{restrictedSourceNotice}</p> : <pre class="exp-source-code" aria-label={`Original source ${excerpt.path}, lines ${excerpt.lineStart} to ${excerpt.lineEnd}`}><code>{lines.map((line, index) => <span class="exp-code-line" data-source-line={excerpt.lineStart + index}>{line}{'\n'}</span>)}</code></pre>}
    <dl class="exp-provenance">
      <dt>Capture</dt><dd>{excerpt.capturedAt} · {excerpt.normalization}</dd>
      <dt>File SHA-256</dt><dd><code>{excerpt.sha256}</code></dd>
      <dt>Excerpt SHA-256</dt><dd><code>{excerpt.excerptSha256}</code></dd>
      <dt>Original HEAD</dt><dd><code>{excerpt.originalHead}</code> · {excerpt.dirty ? 'worktree had uncommitted changes' : 'clean worktree at capture'}</dd>
      <dt>Historical relation</dt><dd>{excerpt.historicalRelation} — {excerpt.historicalNote}</dd>
      <dt>Rights</dt><dd>{excerpt.rightsNote}</dd>
    </dl>
  </div>
</details>
