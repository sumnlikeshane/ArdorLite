---
interface Props { title?: string; description: string; links?: Array<{href: string; label: string}>; }
const { title = 'Recorded research context', description, links = [] } = Astro.props;
---
<aside class="exp-evidence-context" aria-label={title}>
  <strong>{title}</strong><p>{description}</p>
  {links.length > 0 && <ul>{links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
  <slot />
</aside>
