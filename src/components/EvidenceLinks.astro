---
import type { Entity } from '../lib/evidence/crosswalk';
import '../styles/evidence.css';
interface Props { title: string; entries: Entity[]; note?: string; }
const { title, entries, note } = Astro.props;
---
{entries.length > 0 && <details data-pagefind-ignore class="evidence-links">
  <summary>{title} ({entries.length})</summary>
  {note && <p class="small">{note}</p>}
  <ul>{entries.map(entry => <li><a href={entry.href}>{entry.label}</a></li>)}</ul>
</details>}
